use aleph_syntax_tree::syntax::AlephTree as at;
use aleph_syntax_tree::types::{Type, Variant};
use aleph_syntax_tree::effects::{Effect, EffectSet};

grammar;

pub Stmts = {
    Let,
    <stmts:Stmts> ";" => stmts,
    <stmts:Stmts> ";" <e:Let> => at::Stmts{expr1: Box::new(stmts), expr2: Box::new(e)}
}

Elems: Vec<Box<at>> = {
    <e:Let> => vec![Box::new(e)],
    <mut el:Elems> "," <e:Let> => {
        el.push(Box::new(e));
        el
    }
}

Let = {
    Expr,
    <left:Expr> "=" <right:Expr> => match left {
        at::Get{array_name, elem} => at::Put{array_name: array_name, elem: elem, value: Box::new(right), insert: "false".to_string()},
        at::Put{array_name, elem, value: _value, insert} => at::Put{array_name: array_name, elem: elem, value: Box::new(right), insert: insert},
        _ => at::Let{var: left.to_string_value(), is_pointer: "false".to_string(), value: Box::new(right), expr: Box::new(at::Unit)},
    },
    <left:Ident> ":" "=" <right:Expr> => at::Let{var: left.to_string_value(), is_pointer: "true".to_string(), value: Box::new(right), expr: Box::new(at::Unit)},
    // Kept out of Expr (not operator precedence-tagged) because VariantList's "|"
    // separator would otherwise conflict with Expr's "|" (Or) operator — same
    // reasoning as CogExpr below.
    "type" <name:UpperIdent> "=" <variants:VariantList> => at::TypeDef{name, variants},
    // Kept out of Expr for the same reason as TypeDef above: these two
    // productions contain a literal "|" token (return type | effect list),
    // which would collide with Expr's own "|" (Or) precedence-macro rule.
    "fun" <name:Ident> "(" ")" "->" <ret:TypeExpr> "|" <effs:EffectList> "=" "{" <body:Stmts> "}" => at::WithEffects{
        inner: Box::new(at::Typed{
            inner: Box::new(at::LetRec{name: name.to_string_value(), args: Vec::new(), body: Box::new(body)}),
            ty: Type::Fun{params: Vec::new(), ret: Box::new(ret)},
        }),
        effects: effs,
    },
    "fun" <name:Ident> "(" <params:Params> ")" "->" <ret:TypeExpr> "|" <effs:EffectList> "=" "{" <body:Stmts> "}" => {
        // Only the leading contiguous run of typed params — matches
        // alegen's gen_params contract, where param_types's length is the
        // signal for how many leading params are typed. An untyped param
        // anywhere in the list stops collection at that point; there is no
        // placeholder for "untyped mid-list" because none of Type's
        // variants safely means that (Type::Var already means
        // "unresolved/generic type reference", not "no annotation").
        let param_types: Vec<Type> = params.iter().map_while(|p| match &**p {
            at::Typed{ty, ..} => Some(ty.clone()),
            _ => None,
        }).collect();
        at::WithEffects{
            inner: Box::new(at::Typed{
                inner: Box::new(at::LetRec{name: name.to_string_value(), args: params, body: Box::new(body)}),
                ty: Type::Fun{params: param_types, ret: Box::new(ret)},
            }),
            effects: effs,
        }
    },
    // ── Cognitive Layer ───────────────────────────────────────────────────
    // CogExpr (Term + App calls, no operators) keeps these rules unambiguous.
    "intention" <name:Ident> "(" ")" "=" "{" <body:Stmts> "}"
        => at::Intend{name: name.to_string_value(), params: Vec::new(), body: Box::new(body)},
    "intention" <name:Ident> "(" <params:Elems> ")" "=" "{" <body:Stmts> "}"
        => at::Intend{name: name.to_string_value(), params: params, body: Box::new(body)},
    "suggest" <var:Ident> "from" <ctx:CogExpr>
        => at::Suggest{var: var.to_string_value(), context: Box::new(ctx), options: Vec::new(), fallback: None},
    "act" <intention:CogExpr>
        => at::Act{intention: Box::new(intention), effect: None},
    "act" <intention:CogExpr> "as" <eff:Ident>
        => at::Act{intention: Box::new(intention), effect: Some(Box::new(eff))},
    "remember" <key:String> "=" <val:CogExpr>
        => at::Remember{key: Box::new(key), value: Box::new(val), ttl: None},
    "remember" <key:String> "=" <val:CogExpr> "for" <ttl:CogExpr>
        => at::Remember{key: Box::new(key), value: Box::new(val), ttl: Some(Box::new(ttl))},
    "perceive" <src:CogExpr>
        => at::Perceive{source: Box::new(src), pattern: None, var: None},
    "perceive" <src:CogExpr> "as" <var:Ident>
        => at::Perceive{source: Box::new(src), pattern: None, var: Some(var.to_string_value())},
}

Expr = {
    #[precedence(level="0")]
    Term,
    #[precedence(level="4")]
    "(" <init:Expr>";" <condition:Expr> ";" <post:Expr> ")" "?" "*" "{" <then:Stmts> "}" => at::While{init_expr: Box::new(init), condition: Box::new(condition), loop_expr: Box::new(then), post_expr: Box::new(post)},
    #[precedence(level="4")] #[assoc(side="left")]
    <left:Expr> "-" <right:Expr> => at::Sub{number_expr1:Box::new(left), number_expr2:Box::new(right)},
    #[precedence(level="4")] #[assoc(side="left")]
    <left:Expr> "+" <right:Expr> => at::Add{number_expr1:Box::new(left), number_expr2:Box::new(right)},
    #[precedence(level="4")]
    <condition:Expr> "?" "{" <then:Stmts> "}" => at::If{condition: Box::new(condition), then: Box::new(then), els: Box::new(at::Unit)},
    #[precedence(level="4")]
    <condition:Expr> "?" "{" <then:Stmts> "}" ":" "{" <els:Stmts> "}" => at::If{condition: Box::new(condition), then: Box::new(then), els: Box::new(els)},
    #[precedence(level="4")]
    <condition:Expr> "?" "*" "{" <then:Stmts> "}" => at::While{init_expr: Box::new(at::Unit), condition: Box::new(condition), loop_expr: Box::new(then), post_expr: Box::new(at::Unit)},
    #[precedence(level="3")]
    "return" <e:Expr> => at::Return{value: Box::new(e)},
    #[precedence(level="2")] #[assoc(side="left")]
    <left:Expr> "|" <right:Expr> => at::Or{bool_expr1:Box::new(left), bool_expr2:Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "*" <right:Expr> => at::Mul{number_expr1:Box::new(left), number_expr2:Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "/" <right:Expr> => at::Div{number_expr1:Box::new(left), number_expr2:Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "&" <right:Expr> => at::And{bool_expr1:Box::new(left), bool_expr2:Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "==" <right:Expr> => at::Eq{expr1: Box::new(left), expr2: Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "<=" <right:Expr> => at::LE{expr1: Box::new(left), expr2: Box::new(right)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "<" <right:Expr> => at::Not{bool_expr: Box::new(at::LE{expr1: Box::new(right), expr2: Box::new(left)})},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> ">=" <right:Expr> => at::LE{expr1: Box::new(right), expr2: Box::new(left)},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> ">" <right:Expr> => at::Not{bool_expr: Box::new(at::LE{expr1: Box::new(left), expr2: Box::new(right)})},
    #[precedence(level="1")] #[assoc(side="left")]
    <left:Expr> "in" <right:Expr> => at::In{expr1: Box::new(left), expr2: Box::new(right)},
    "import" <import:Term> => at::Iprt{name: import.to_string_value(),items: Vec::new()},
    "class" <name:Ident> "{" <body:Stmts> "}" => at::Clss{name: name.to_string_value(), attribute_list: Vec::new(), extends: None, implements: Vec::new(), body: Box::new(body)},
    <name:Ident> "(" ")" => at::App{object_name: "".to_string(), fun: Box::new(name), param_list: Vec::new()},
    <name:Ident> "(" <elems:Elems> ")" => at::App{object_name: "".to_string(), fun: Box::new(name), param_list: elems},
    <cname: Ident> "." <name:Ident> "(" ")" => at::App{object_name: cname.to_string_value(), fun: Box::new(name), param_list: Vec::new()},
    <cname: Ident> "." <name:Ident> "(" <elems:Elems> ")" => at::App{object_name: cname.to_string_value(), fun: Box::new(name), param_list: elems},
    "fun" <name:Ident> "(" ")" "=" "{" <body:Stmts> "}" => at::LetRec{name: name.to_string_value(), args: Vec::new(), body: Box::new(body)},
    "fun" <name:Ident> "(" <params:Params> ")" "=" "{" <body:Stmts> "}" => at::LetRec{name: name.to_string_value(), args: params, body: Box::new(body)},
    "fun" <name:Ident> "(" ")" "->" <ret:TypeExpr> "=" "{" <body:Stmts> "}" => at::Typed{
        inner: Box::new(at::LetRec{name: name.to_string_value(), args: Vec::new(), body: Box::new(body)}),
        ty: Type::Fun{params: Vec::new(), ret: Box::new(ret)},
    },
    "fun" <name:Ident> "(" <params:Params> ")" "->" <ret:TypeExpr> "=" "{" <body:Stmts> "}" => {
        // See the with-effects variant of this production above for why
        // this only collects the leading contiguous run of typed params.
        let param_types: Vec<Type> = params.iter().map_while(|p| match &**p {
            at::Typed{ty, ..} => Some(ty.clone()),
            _ => None,
        }).collect();
        at::Typed{
            inner: Box::new(at::LetRec{name: name.to_string_value(), args: params, body: Box::new(body)}),
            ty: Type::Fun{params: param_types, ret: Box::new(ret)},
        }
    },
    <name:Ident> "[" "/" <key:Expr> "]" => at::Remove{array_name: name.to_string_value(), elem: Box::new(key), is_value: "false".to_string()},
    "match" <e:Expr> "with" <match_list:MatchList> => at::Match{expr: Box::new(e), case_list: match_list},
    <condition:Expr> <message:String> => at::Assert{condition: Box::new(condition), message: Box::new(message)},
}

// Term + function calls, no operators.
// Used by cognitive rules to avoid shift-reduce conflicts with Expr operators.
CogExpr = {
    Term,
    <name:Ident> "(" ")" => at::App{object_name: "".to_string(), fun: Box::new(name), param_list: Vec::new()},
    <name:Ident> "(" <elems:Elems> ")" => at::App{object_name: "".to_string(), fun: Box::new(name), param_list: elems},
    <cname:Ident> "." <name:Ident> "(" ")" => at::App{object_name: cname.to_string_value(), fun: Box::new(name), param_list: Vec::new()},
    <cname:Ident> "." <name:Ident> "(" <elems:Elems> ")" => at::App{object_name: cname.to_string_value(), fun: Box::new(name), param_list: elems},
}

Term = {
    Num,
    String,
    Ident,
    Comment,
    CommentLine,
    "(" <e:Expr> ")" => e,
    "-" <right:Term> => at::Neg{expr:Box::new(right)},
    "!" <right:Term> => at::Not{bool_expr: Box::new(right)},
    <name:Ident> "[" <key:LeftAdd> "]" => match key {
        (k,true) => at::Put{array_name: name.to_string_value(), elem: Box::new(k), value: Box::new(at::Unit), insert: "true".to_string()},
        (k,_) => match k {
            at::Neg{expr} => at::Remove{array_name: name.to_string_value(), elem: expr, is_value: "true".to_string()},
            _ => at::Get{array_name: name.to_string_value(), elem: Box::new(k)},
        },
    },
    "[" <el:Elems> "]" => at::Array{elems: el},
    "[" "]" => at::Array{elems: Vec::new()},
    "|" <ident:Ident> "|" => at::Length{var: ident.to_string_value()},
}

Num: at = r"[0-9]+(\.[0-9]+){0,1}" => match <>.to_string() {
    f if f.contains(".") => at::Float{value: f},
    i => at::Int{value: i}
};
Ident: at = r"[a-z](\d|[A-Za-z]|_)*" => match <> {
    "true" | "false" => at::Bool{value: <>.to_string()},
    _ => at::Ident{value: <>.to_string()},
};
String: at = r#""[^\"]*""# => at::String{value: <>.to_string()};
Comment : at = r#"/\*([^\*/]*)\*/"# => at::CommentMulti{value: <>.to_string()};
CommentLine : at = r#"//([^\n]*)\n"# => at::Comment{value: <>.to_string()};

LeftAdd:(at, bool) = {
    <left:Expr> => (left, false),
    <left:Expr> "+" => (left, true),
}

MatchLine = {
    Ident,
    // Was `"-" ">"` (two separate literal tokens) until this grammar also
    // introduced a single `"->"` literal token for typed-function return
    // arrows (0.2). LALRPOP's lexer then always tokenizes an in-source `->`
    // as that one token, never as adjacent `-` then `>` — so the old
    // two-token form silently stopped matching real `->` input. Surface
    // syntax is unchanged (still literally `->`); only the grammar rule's
    // own token expectation needed to catch up to the lexer.
    ":" <left:Term> "->" <right:Term> ":" => at::MatchLine{condition: Box::new(left), case_expr: Box::new(right)},
}

MatchList: Vec<Box<at>> = {
    <MatchLine> => vec![Box::new(<>)],
    <mut el:MatchList> <e:MatchLine> => {
        el.push(Box::new(e));
        el
    }
}

UpperIdent: String = r"[A-Z](\d|[A-Za-z]|_)*" => <>.to_string();

// Falls back to Type::Var for anything not a recognized primitive keyword —
// covers both a genuine type-variable/nominal-type reference (e.g. `Shape`
// in `fun f(s: Shape)`) and a misspelled/unknown name (e.g. `Itn` instead of
// `Int`). No type checker exists yet to tell these apart; both parse
// successfully and are left for a future validation pass.
TypeExpr: Type = <name:UpperIdent> => match name.as_str() {
    "Int" => Type::Int,
    "Float" => Type::Float,
    "Bool" => Type::Bool,
    "String" => Type::String,
    "Bytes" => Type::Bytes,
    "Unit" => Type::Unit,
    _ => Type::Var{name},
};

TypeExprList: Vec<Type> = {
    <t:TypeExpr> => vec![t],
    <mut tl:TypeExprList> "," <t:TypeExpr> => { tl.push(t); tl },
}

Variant: Variant = {
    <name:UpperIdent> => Variant{name, fields: Vec::new()},
    <name:UpperIdent> "(" <fields:TypeExprList> ")" => Variant{name, fields},
}

VariantList: Vec<Variant> = {
    <v:Variant> => vec![v],
    <mut vl:VariantList> "|" <v:Variant> => { vl.push(v); vl },
}

Param: at = {
    Ident,
    <name:Ident> ":" <ty:TypeExpr> => at::Typed{inner: Box::new(name), ty},
}

Params: Vec<Box<at>> = {
    <p:Param> => vec![Box::new(p)],
    <mut el:Params> "," <p:Param> => { el.push(Box::new(p)); el },
}

// "act" is handled as its own alternative (not via the Ident match arm
// below) because "act" is already a literal keyword token elsewhere in this
// grammar (the cognitive-layer Act rule) — LALRPOP's lexer always prefers a
// literal-string token over a same-text regex token, so input "act" lexes
// as that keyword, never as Ident; the Ident-based match could never see it.
EffectName: Effect = {
    <i:Ident> => match i.to_string_value().as_str() {
        "pure" => Effect::Pure,
        "io" => Effect::Io,
        "net" => Effect::Net,
        "mut" => Effect::Mut,
        // Unlike TypeExpr (which degrades an unrecognized name to Type::Var),
        // there is no safe "unknown effect" fallback: Effect is a small closed
        // enum with no catch-all variant, and silently mapping a typo to e.g.
        // Effect::Pure would misrepresent a function's actual effects, which is
        // worse than failing loudly. This panics rather than propagating a
        // proper parse error because this crate's `parse()` doesn't yet have
        // fallible-action plumbing (LALRPOP's `=>?` productions) wired up —
        // tracked as future work, not attempted here.
        other => panic!("unknown effect '{}'", other),
    },
    "act" => Effect::Act,
};

EffectList: EffectSet = {
    <e:EffectName> => EffectSet::from([e]),
    <mut set:EffectList> "," <e:EffectName> => { set.insert(e); set },
}
